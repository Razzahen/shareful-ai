{
  "name": "shareful-ai",
  "version": "0.1.3",
  "description": "Stack Overflow for AI Coding Agents — share verified fixes as markdown, agents find them on-demand",
  "type": "module",
  "bin": {
    "shareful-ai": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "obuild",
    "dev": "node src/cli.ts",
    "prepublishOnly": "npm run build",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "shareful",
    "ai",
    "coding-solutions",
    "knowledge-sharing",
    "markdown",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shareful-ai/shareful-ai.git"
  },
  "homepage": "https://shareful.ai",
  "bugs": {
    "url": "https://github.com/shareful-ai/shareful-ai/issues"
  },
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "obuild": "^0.4.22",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
